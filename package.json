{
  "name": "abyss.ts",
  "version": "0.0.1",
  "author": "Alpha",
  "description": "Node.JS framework bootstrap",
  "repository": {
    "type": "git",
    "url": "git@github.com:zgid123/abyss-ts.git"
  },
  "license": "MIT",
  "keywords": [
    "abyss",
    "abyssts",
    "abyssjs",
    "abyss.js",
    "abyss.ts",
    "node",
    "express"
  ],
  "type": "module",
  "private": true,
  "scripts": {
    "prepare": "husky || true",
    "preinstall": "npx only-allow pnpm",
    "clear": "pnpm -r exec rimraf node_modules dist .turbo lib && pnpm rimraf node_modules .turbo",
    "update-packages": "pnpm update -i -r --latest",
    "build": "turbo run build",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs",
    "test": "vitest run --coverage"
  },
  "packageManager": "pnpm@10.24.0",
  "devDependencies": {
    "@alphacifer/biome": "^0.0.5",
    "@alphacifer/tsconfig": "^0.0.7",
    "@biomejs/biome": "^2.3.8",
    "@swc/core": "^1.7.6",
    "@types/globals": "workspace:^",
    "@vitest/coverage-istanbul": "^4.0.15",
    "@vitest/coverage-v8": "4.0.15",
    "lefthook": "^2.0.9",
    "rimraf": "^6.0.1",
    "tsdown": "0.17.2",
    "turbo": "^2.6.3",
    "typescript": "^5.5.4",
    "vitepress": "^1.3.1",
    "vitest": "^4.0.15"
  },
  "dependencies": {
    "tslib": "^2.6.3"
  }
}
